            <Param name="conditions" val="[]" valType="str" updates="None" plugin="None"/>
            <Param name="endPoints" val="[0,1]" valType="code" updates="None" plugin="None"/>
        </LoopInitiator>
        <Routine name="fixation_cross3"/>
        <Routine name="recognition_trial"/>
        <LoopTerminator name="recognition_trials"/>
        <Routine name="show_end_block"/>
        <LoopTerminator name="blocks"/>
        <Routine name="goodbye"/>
