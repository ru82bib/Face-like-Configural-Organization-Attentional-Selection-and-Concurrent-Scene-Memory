                <Param name="text" val="$&quot;Block &quot; + str(sessionNum) + &quot;/ 4 \n\n In this experiment, you will press 'SPACE' when you see the target. \n\n The target for this block is &quot; + target + &quot; images same as the practice trial.\n\n Please memorize the background images, later you will be probed about background images. \n\n To start the block, please press SPACE.&quot;" valType="str" updates="set every repeat" plugin="None"/>
                <Param name="font" val="Arial" valType="str" updates="constant" plugin="None"/>
                <Param name="draggable" val="False" valType="code" updates="constant" plugin="None"/>
                <Param name="letterHeight" val="0.05" valType="num" updates="constant" plugin="None"/>
                <Param name="wrapWidth" val="" valType="num" updates="constant" plugin="None"/>
