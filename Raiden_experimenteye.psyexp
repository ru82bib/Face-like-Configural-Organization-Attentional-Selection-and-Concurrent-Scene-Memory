            <Param name="Selected rows" val="" valType="str" updates="None" plugin="None"/>
            <Param name="random seed" val="" valType="code" updates="None" plugin="None"/>
            <Param name="conditions" val="[{&quot;practice_img&quot;:&quot;practice/practice1.jpg&quot;,&quot;central_img&quot;:&quot;practice/non_target_1.png&quot;,&quot;label&quot;:&quot;distractor&quot;,&quot;is_target&quot;:0,&quot;correct_key&quot;:&quot;none&quot;},{&quot;practice_img&quot;:&quot;practice/practice2.jpg&quot;,&quot;central_img&quot;:&quot;practice/target_1.png&quot;,&quot;label&quot;:&quot;target&quot;,&quot;is_target&quot;:1,&quot;correct_key&quot;:&quot;space&quot;},{&quot;practice_img&quot;:&quot;practice/practice3.jpg&quot;,&quot;central_img&quot;:&quot;practice/non_target_2.png&quot;,&quot;label&quot;:&quot;distractor&quot;,&quot;is_target&quot;:0,&quot;correct_key&quot;:&quot;none&quot;},{&quot;practice_img&quot;:&quot;practice/practice4.jpg&quot;,&quot;central_img&quot;:&quot;practice/baseline.png&quot;,&quot;label&quot;:&quot;baseline&quot;,&quot;is_target&quot;:0,&quot;correct_key&quot;:&quot;none&quot;},{&quot;practice_img&quot;:&quot;practice/practice5.jpg&quot;,&quot;central_img&quot;:&quot;practice/target_2.png&quot;,&quot;label&quot;:&quot;target&quot;,&quot;is_target&quot;:1,&quot;correct_key&quot;:&quot;space&quot;},{&quot;practice_img&quot;:&quot;practice/practice6.jpg&quot;,&quot;central_img&quot;:&quot;practice/non_target_3.png&quot;,&quot;label&quot;:&quot;distractor&quot;,&quot;is_target&quot;:0,&quot;correct_key&quot;:&quot;none&quot;},{&quot;practice_img&quot;:&quot;practice/practice7.jpg&quot;,&quot;central_img&quot;:&quot;practice/baseline.png&quot;,&quot;label&quot;:&quot;baseline&quot;,&quot;is_target&quot;:0,&quot;correct_key&quot;:&quot;none&quot;},{&quot;practice_img&quot;:&quot;practice/practice8.jpg&quot;,&quot;central_img&quot;:&quot;practice/target_3.png&quot;,&quot;label&quot;:&quot;target&quot;,&quot;is_target&quot;:1,&quot;correct_key&quot;:&quot;space&quot;},{&quot;practice_img&quot;:&quot;practice/practice9.jpg&quot;,&quot;central_img&quot;:&quot;practice/baseline.png&quot;,&quot;label&quot;:&quot;baseline&quot;,&quot;is_target&quot;:0,&quot;correct_key&quot;:&quot;none&quot;},{&quot;practice_img&quot;:&quot;practice/practice10.jpg&quot;,&quot;central_img&quot;:&quot;practice/target_4.png&quot;,&quot;label&quot;:&quot;target&quot;,&quot;is_target&quot;:1,&quot;correct_key&quot;:&quot;space&quot;}]" valType="str" updates="None" plugin="None"/>
            <Param name="endPoints" val="[0,1]" valType="num" updates="None" plugin="None"/>
        </LoopInitiator>
        <Routine name="fixation_cross"/>
        <Routine name="Practice_Trial"/>
        <LoopTerminator name="trials"/>
        <Routine name="Instruction"/>
