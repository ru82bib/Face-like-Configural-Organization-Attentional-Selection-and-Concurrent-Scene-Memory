            <Param name="Selected rows" val="" valType="str" updates="None" plugin="None"/>
            <Param name="random seed" val="" valType="code" updates="None" plugin="None"/>
            <Param name="conditions" val="[]" valType="str" updates="None" plugin="None"/>
            <Param name="endPoints" val="[0,1]" valType="code" updates="None" plugin="None"/>
        </LoopInitiator>
        <Routine name="fixation_cross2"/>
        <Routine name="encoding_trial"/>
        <LoopTerminator name="encoding_trials"/>
        <Routine name="stoprecord"/>
        <Routine name="inst_recognition"/>
